#!/bin/sh
# Medicion Obra - postinst
# Copyright (C) 2026 JMBernabeu - GPL-3.0-or-later
set -e

case "$1" in
  configure)
    mkdir -p /var/lib/medicion-obra
    chown -R www-data:www-data /var/lib/medicion-obra
    chmod 755 /var/lib/medicion-obra

    # Crear credenciales de acceso (solo si no existen)
    mkdir -p /etc/medicion-obra
    if [ ! -f /etc/medicion-obra/.htpasswd ]; then
      PASS=$(openssl rand -base64 12 | tr -d '/+=' | head -c 12)
      HASH=$(openssl passwd -apr1 "$PASS" 2>/dev/null)
      echo "admin:$HASH" > /etc/medicion-obra/.htpasswd
      chmod 644 /etc/medicion-obra/.htpasswd
      echo ""
      echo "==========================================="
      echo " Credenciales de Medicion Obra"
      echo "   Usuario:     admin"
      echo "   Contrasena:  $PASS"
      echo " Guarda esta informacion para acceder"
      echo " desde el movil o desde internet."
      echo "==========================================="
      echo ""
    fi

    # Activar el sitio nginx de la app
    ln -sf /etc/nginx/sites-available/medicion-obra /etc/nginx/sites-enabled/medicion-obra
    rm -f /etc/nginx/sites-enabled/default

    # Activar e iniciar el servicio de la API local
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable medicion-obra.service >/dev/null 2>&1 || true
    systemctl restart medicion-obra.service >/dev/null 2>&1 || true

    # Aplicar la configuracion de nginx
    if command -v nginx >/dev/null 2>&1; then
      nginx -t >/dev/null 2>&1 || true
      systemctl reload nginx >/dev/null 2>&1 || systemctl restart nginx >/dev/null 2>&1 || true
    fi

    # Refrescar el icono y el lanzador en el menu de aplicaciones
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
      gtk-update-icon-cache /usr/share/icons/hicolor >/dev/null 2>&1 || true
    fi
    if command -v update-desktop-database >/dev/null 2>&1; then
      update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
