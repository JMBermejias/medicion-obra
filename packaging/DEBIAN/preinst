set -e

# Garantizar los directorios antes de que dpkg desempaquete los ficheros
# (necesario en sistemas sin /var/www).
mkdir -p /var/www/medicion-obra
mkdir -p /var/lib/medicion-obra
mkdir -p /usr/lib/medicion-obra
mkdir -p /usr/share/doc/medicion-obra

exit 0
