server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /var/www/medicion-obra;
    index mediotec.html;

    # Autenticacion basica (protege el acceso desde internet)
    auth_basic "Medicion Obra";
    auth_basic_user_file /etc/medicion-obra/.htpasswd;

    location / {
        try_files $uri $uri/ /mediotec.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
