[Unit]
Description=Medicion Obra - API local (SQLite)
Documentation=https://github.com/JMBermejias/medicion-obra
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
ExecStart=/usr/bin/python3 /usr/lib/medicion-obra/medicion_server.py
WorkingDirectory=/usr/lib/medicion-obra
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
